# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hono_boilerplate

# Redis (idempotency cache, rate-limit store, BetterAuth secondary storage)
REDIS_URL=redis://localhost:6379

# BetterAuth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-strong-random-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000

# CORS — comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
